# Copy to .env and fill in your own values. NEVER commit .env.
DATABASE_URL="file:./dev.db"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Platform owner info shown on the billing page (optional)
PLATFORM_NAME="CitaFácil"
PLATFORM_NEQUI="3001234567"
PLATFORM_BANK="Bank Savings 000-0000000-00"
PLATFORM_WHATSAPP="3001234567"

# Password for the demo user created by `npm run db:seed` (demo@example.com)
SEED_DEMO_PASSWORD="choose-a-demo-password"
